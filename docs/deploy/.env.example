# Public address that Michel OS will use. Point this hostname at the VPS first.
CADDY_DOMAIN=michel.example.com
BASE_URL=https://michel.example.com

# Keep these URL-safe because DATABASE_URL is assembled from them in compose.yml.
POSTGRES_DB=michel
POSTGRES_USER=michel
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Optional comma-separated additional browser origins, for example a trusted LAN URL.
EXTRA_ORIGINS=
