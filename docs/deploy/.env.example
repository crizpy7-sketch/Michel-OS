# Public address that Michel OS will use. Point this hostname at the VPS first.
CADDY_DOMAIN=michel.example.com
BASE_URL=https://michel.example.com

# Shared-VPS mode only. Michel OS binds this host port on 127.0.0.1, never
# 0.0.0.0. Change it only if the preflight shows 3100 is already occupied.
MICHEL_BIND_PORT=3100

# Keep these URL-safe because DATABASE_URL is assembled from them in compose.yml.
POSTGRES_DB=michel
POSTGRES_USER=michel
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Optional OpenAI Assistant. Leave OPENAI_API_KEY blank to keep the deterministic
# local parser; the rest of Michel OS continues to work without an AI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional comma-separated additional browser origins, for example a trusted LAN URL.
EXTRA_ORIGINS=

# --- Auto-deploy (docs/deploy/auto-deploy.sh) --------------------------------
# Branch the VPS follows. Anything pushed here goes live once CI is green.
MICHEL_DEPLOY_BRANCH=main

# Refuse to deploy a commit whose `gauntlet` workflow did not pass. Leave this
# true: without it, any broken push takes the family calendar down on its own.
MICHEL_REQUIRE_CI=true

# Needed only for a PRIVATE repo, so auto-deploy can read commit check status.
# A fine-grained token with read-only Actions + Contents on this repo is enough.
GITHUB_TOKEN=

# Override only for a standalone (Caddy-owning) deployment:
# MICHEL_COMPOSE_FILE=compose.yml
