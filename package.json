{
  "name": "michel-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Family Scheduling OS — swarm-built, gauntlet-verified",
  "scripts": {
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "swarm": "node --experimental-strip-types tools/swarm/run.ts",
    "gauntlet": "node --experimental-strip-types tools/swarm/gauntlet.ts",
    "migrate": "node --experimental-strip-types server/db/migrate-cli.ts",
    "start": "node --experimental-strip-types server/main.ts",
    "icons": "node --experimental-strip-types tools/assets/icons.ts",
    "icons:check": "node --experimental-strip-types tools/assets/icons.ts --check",
    "lint": "node tools/lint/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "sharp": "0.35.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "pg": "^8.23.0"
  }
}
